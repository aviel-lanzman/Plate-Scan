<?xml version="1.0" encoding="utf-8"?>
<!-- The check history holds plate numbers, and the privacy policy says it
     never leaves the device. This keeps it out of cloud backup and of
     phone-to-phone transfer on Android 12 and later; allowBackup="false" in
     the manifest covers older versions. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
